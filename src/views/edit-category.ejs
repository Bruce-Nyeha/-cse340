<%- include('partials/header') %>

<main class="detail-page-container">
    <h1 class="main-detail-title"><%= title %></h1>
    
    <div class="info-details-card">
        <!-- Sends a POST request to update the specific category by ID -->
        <form action="/edit-category/<%= category.category_id %>" method="POST" class="form-layout-box">
            
            <div class="form-group-item">
                <label for="category_name" class="form-element-label">Category Name</label>
                <!-- Pre-populated value with the existing category name -->
                <input 
                    type="text" 
                    id="category_name" 
                    name="category_name" 
                    class="form-text-input" 
                    value="<%= category.category_name %>"
                    maxlength="100" 
                    required 
                />
            </div>
            
            <div class="form-actions-row">
                <button type="submit" class="submit-action-btn">Update Category</button>
                <a href="/categories" class="cancel-action-link">Cancel</a>
            </div>
            
        </form>
    </div>
</main>

<%- include('partials/footer') %>
