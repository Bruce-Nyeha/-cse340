<%- include('partials/header') %>
<main class="detail-page-container">
    <h1 class="main-detail-title">Register New Organization</h1>
    <div class="info-details-card">
        <form action="/new-organization" method="POST" class="form-layout-box">
            <div class="form-group-item">
                <label for="name" class="form-element-label">Organization Name</label>
                <input type="text" id="name" name="name" class="form-text-input" required>
            </div>
            <div class="form-group-item">
                <label for="email" class="form-element-label">Contact Email</label>
                <input type="email" id="email" name="email" class="form-text-input" required>
            </div>
            <div class="form-group-item">
                <label for="description" class="form-element-label">Description</label>
                <textarea id="description" name="description" class="form-text-input" required></textarea>
            </div>
            <div class="form-actions-row">
                <button type="submit" class="submit-action-btn">Create Organization</button>
                <a href="/organizations" class="cancel-action-link">Cancel</a>
            </div>
        </form>
    </div>
</main>
<%- include('partials/footer') %>
