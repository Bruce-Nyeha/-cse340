<%- include('partials/header') %>

<main class="auth-page-main-container">
    <div class="auth-content-card-box">
        
        <h1 class="auth-main-heading"><%= title %></h1>
        
        <form action="/register" method="POST" class="form-layout-box">
            
            <div class="form-group-item">
                <label for="name" class="form-element-label">Full Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="form-text-input" 
                    placeholder="John Smith" 
                    required 
                />
            </div>

            <!-- 🚀 ADDED: Email Input Vector Field Entry -->
            <div class="form-group-item">
                <label for="email" class="form-element-label">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="form-text-input" 
                    placeholder="john.smith@byui.edu" 
                    required 
                />
            </div>

            <!-- 🚀 ADDED: Password Input Vector Field Entry -->
            <div class="form-group-item">
                <label for="password" class="form-element-label">Password</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    class="form-text-input" 
                    placeholder="Minimum 6 characters" 
                    required 
                />
            </div>
            
            <div class="form-actions-row">
                <button type="submit" class="submit-action-btn">Register</button>
            </div>
            
        </form>
        
        <p class="auth-switch-prompt-text" style="margin-top: 1.5rem; font-size: 0.9rem; color: #475569;">
            Already have an account? <a href="/login" style="color: #2563eb; text-decoration: none; font-weight: 600;">Login here</a>.
        </p>
        
    </div>
</main>

<%- include('partials/footer') %>
