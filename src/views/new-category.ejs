<%- include('partials/header') %>

<main class="detail-page-container">
    <h1 class="main-detail-title"><%= title %></h1>
    
    <div class="info-details-card">
        <!-- POST request routes processing to centralized category creation handlers -->
        <form action="/new-category" method="POST" class="form-layout-box">
            
            <div class="form-group-item">
                <label for="category_name" class="form-element-label">Category Name</label>
                <!-- Required and Maxlength attributes handle client validation. -->
                <!-- Minlength is deliberately omitted here to test server-side validation. -->
                <input 
                    type="text" 
                    id="category_name" 
                    name="category_name" 
                    class="form-text-input" 
                    maxlength="100" 
                    required 
                    placeholder="e.g., Youth Outreach"
                />
            </div>
            
            <div class="form-actions-row">
                <button type="submit" class="submit-action-btn">Create Category</button>
                <a href="/categories" class="cancel-action-link">Cancel</a>
            </div>
            
        </form>
    </div>
</main>

<%- include('partials/footer') %>
