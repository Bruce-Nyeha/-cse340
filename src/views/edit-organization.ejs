<%- include('partials/header') %>
<main class="detail-page-container">
    <h1 class="main-detail-title">Edit Organization Profile</h1>
    <div class="info-details-card">
        <form action="/edit-organization/<%= organization.organization_id %>" method="POST" class="form-layout-box">
            <div class="form-group-item">
                <label for="name" class="form-element-label">Organization Name</label>
                <input type="text" id="name" name="name" class="form-text-input" value="<%= organization.name %>" required>
            </div>
            <div class="form-group-item">
                <label for="email" class="form-element-label">Contact Email</label>
                <input type="email" id="email" name="email" class="form-text-input" value="<%= organization.email %>" required>
            </div>
            <div class="form-group-item">
                <label for="description" class="form-element-label">Description</label>
                <textarea id="description" name="description" class="form-text-input" required><%= organization.description %></textarea>
            </div>
            <!--Automatically populated pre-filled logo value tracking input field at the bottom -->
            <div class="form-group-item">
                <label for="logo" class="form-element-label">Logo Profile Graphic URL / Filename</label>
                <input type="text" id="logo" name="logo" class="form-text-input" value="<%= organization.logo %>" required>
            </div>
            <div class="form-actions-row">
                <button type="submit" class="submit-action-btn">Update Profile</button>
                <a href="/organizations" class="cancel-action-link">Cancel</a>
            </div>
        </form>
    </div>
</main>
<%- include('partials/footer') %>
