<%- include('partials/header') %>

<main class="detail-page-container">
    <h1 class="main-detail-title"><%= project.title %></h1>
    
    <div class="info-details-card">
        <p class="detail-item-row">
            <strong>Date:</strong> 
            <span class="detail-value-text">
                <img class="detail-calendar-icon" src="/images/calendar.png" alt="Calendar Icon">
                <%= project.date ? new Date(project.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Date TBD' %>
            </span>
        </p>
        
        <p class="detail-item-row">
            <strong>Sponsored By:</strong> 
            <a href="/organization/<%= project.organization_id %>" class="detail-inline-link">
                <%= project.organization_name %>
            </a>
        </p>
        
        <p class="detail-item-row location-row">
            <strong>Location:</strong> 
            <img class="detail-location-icon" src="/images/location.png" alt="Location Icon">
            <span class="detail-value-text"><%= project.location %></span>
        </p>
        
        <p class="detail-item-row description-block">
            <strong>Description:</strong> 
            <span class="detail-value-text"><%= project.description %></span>
        </p>
        
        <div class="details-tags-wrapper">
            <strong class="tags-label">Categories:</strong>
            <div class="tags-list-group">
                <% if (locals.categories && categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                        <a href="/category/<%= cat.category_id %>" class="category-pill-tag">
                            <%= cat.category_name %>
                        </a>
                    <% }); %>
                <% } else { %>
                    <span class="empty-tag-msg">Uncategorized</span>
                <% } %>
            </div>
        </div>
        
        <div class="assignment-link-row" style="margin-top: 2rem; border-top: 1px solid #e2e8f0; padding-top: 1.5rem;">
            <a href="/assign-categories/<%= project.project_id %>" class="add-btn-link">⚙ Assign / Update Categories</a>
        </div>
            
                
        <div class="volunteer-actions-portal-block">
            <% if (locals.user) { %>
                <% const finalProjectId = project.project_id || project.id; %>
                <% if (userIsVolunteering) { %>
                    <p class="volunteer-status-notice-text">✓ You are volunteering for this project.</p>
                    <a href="/unvolunteer/<%= finalProjectId %>" class="cancel-volunteer-link">Cancel Volunteering Assignment</a>
                <% } else { %>
                    <a href="/volunteer/<%= finalProjectId %>" class="add-btn-link">🙋 Volunteer for this Project</a>
                <% } %>
            <% } %>
        </div>


    </div>
    
    <a href="/projects" class="directory-back-link">← Back to All Projects</a>
</main>

<%- include('partials/footer') %>
