<%- include('partials/header') %>

<main class="orgs-main-container">
    <h1 class="page-title">Our Partner Organizations</h1>
    
    <div class="action-footer-row">
        <a href="/new-organization" class="add-btn-link">+ Register New Organization</a>
    </div>

    <div class="orgs-grid-wrapper">
        <% if (locals.organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { 
                let finalImageFile = "default-logo.png";
                let checkName = (org.name || "").toLowerCase();
                if (checkName.includes("brightfuture")) { finalImageFile = "brightfuture-logo.png"; }
                else if (checkName.includes("greenharvest")) { finalImageFile = "greenharvest-logo.png"; }
                else if (checkName.includes("unityserve")) { finalImageFile = "unityserve-logo.png"; }
            %>
                <div class="org-card-item">
                    <h3 class="org-card-title">
                        <a href="/organization/<%= org.organization_id %>">
                            <%= org.name %>
                        </a>
                    </h3>
                    
                    <div class="org-logo-box">
                        <a href="/organization/<%= org.organization_id %>">
                            <img class="org-card-logo" src="/images/<%= finalImageFile %>" alt="Organization Logo">
                        </a>
                    </div>
                    
                    <p class="org-card-description"><%= org.description %></p>
                    <p class="org-card-contact"><strong>Email:</strong> <%= org.email %></p>
                    
                    <div class="card-actions-wrapper">
                        <a href="/edit-organization/<%= org.organization_id %>" class="category-edit-link">Edit Profile</a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No organizations found in the database.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
