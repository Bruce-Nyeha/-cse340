<%- include('partials/header') %>

<main class="projects-main-container">
    <h1 class="page-title">Upcoming Service Projects</h1>
    
    <div class="action-footer-row">
        <a href="/new-project" class="add-btn-link">+ Create New Project</a>
    </div>
    
    <div class="projects-grid-wrapper">
        <% if (locals.projects && projects.length > 0) { %>
            <% projects.forEach((project) => { %>
                <div class="project-card-item">
                    <div class="project-card-header">
                        <span class="project-date">
                            <%= project.date ? new Date(project.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : 'Upcoming Date' %>
                        </span>
                        <h3 class="project-card-title">
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>
                        <span class="project-org-tag">
                            <em><%= project.organization_name %></em>
                        </span>
                    </div>
                    
                    <div class="project-card-body">
                        <p class="project-desc"><%= project.description %></p>
                    </div>
                    
                    <div class="project-card-footer">
                        <p class="project-loc">
                            <img class="location-icon" src="/images/location.png" alt="Location Pin Icon">
                            <%= project.location %>
                        </p>
                        <a href="/edit-project/<%= project.project_id %>" class="category-edit-link">Edit Project</a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p class="no-data-message">No upcoming service projects found.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
